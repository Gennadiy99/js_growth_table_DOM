"use strict";
var meinTabl = document.querySelector(".field");
var addRow = document.querySelector(".append-row");
var addCol = document.querySelector(".append-column");
var remRow = document.querySelector(".remove-row");
var remCol = document.querySelector(".remove-column");
function updateButtonStates() {
    var arrRows = Array.from(meinTabl.rows);
    var rowCount = arrRows.length;
    var cellsCount = arrRows[0].cells.length;
    if (rowCount > 9) addRow.disabled = true;
    else addRow.disabled = false;
    if (rowCount < 3) remRow.disabled = true;
    else remRow.disabled = false;
    if (cellsCount > 9) addCol.disabled = true;
    else addCol.disabled = false;
    if (cellsCount < 3) remCol.disabled = true;
    else remCol.disabled = false;
}
function creatRowTab() {
    var newRow = document.createElement("tr");
    var cauntCol = meinTabl.rows[0].cells.length;
    for(var i = 0; i < cauntCol; i++)newRow.append(document.createElement("td"));
    meinTabl.append(newRow);
}
function creatColTab() {
    var arrRows = Array.from(meinTabl.rows);
    arrRows.forEach(function(row) {
        row.append(document.createElement("td"));
    });
}
function deleteRow() {
    var arrRows = Array.from(meinTabl.rows);
    arrRows.at(-1).remove();
}
function deleteCol() {
    var arrRows = Array.from(meinTabl.rows);
    arrRows.forEach(function(row) {
        row.deleteCell(-1);
    });
}
addRow.addEventListener("click", function(e) {
    creatRowTab();
    updateButtonStates();
});
addCol.addEventListener("click", function(e) {
    creatColTab();
    updateButtonStates();
});
remRow.addEventListener("click", function(e) {
    deleteRow();
    updateButtonStates();
});
remCol.addEventListener("click", function(e) {
    deleteCol();
    updateButtonStates();
});

